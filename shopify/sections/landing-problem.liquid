{% comment %} Section problème/agitation — الألم اللي تعرفه زين {% endcomment %}
<div class="lpp" dir="rtl">
  <div class="lpp__container">
    <h2 class="lpp__heading">{{ section.settings.heading }}</h2>
    <p class="lpp__sub">{{ section.settings.subheading }}</p>
    <div class="lpp__grid">
      {% for block in section.blocks %}
        <div class="lpp__card lpx-reveal" data-delay="{{ forloop.index0 | times: 100 }}" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}<div class="lpp__icon">{{ block.settings.icon }}</div>{% endif %}
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
    <div class="lpp__arrow">
      <span class="lpp__arrowline">والحل أبسط مما تتوقعين</span>
    </div>
  </div>
</div>

<style>
  .lpp{ background:#faf7f2; padding:46px 16px 30px; }
  .lpp__container{ max-width:960px; margin-inline:auto; text-align:center; }
  .lpp__heading{ font-size:1.7rem; font-weight:900; margin:0 0 8px; color:#1b2430; }
  .lpp__sub{ color:#6b7480; margin:0 0 26px; font-size:1rem; }
  .lpp__grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
  .lpp__card{ background:#fff; border-radius:18px; padding:20px 12px; box-shadow:0 10px 30px -18px rgba(16,22,29,.25);
    border-top:3px solid #d64545; }
  .lpp__icon{ font-size:1.9rem; margin-bottom:8px; }
  .lpp__card p{ margin:0; font-size:.9rem; font-weight:600; color:#333; line-height:1.7; }
  .lpp__arrow{ margin-top:26px; }
  .lpp__arrowline{ display:inline-block; background:#1b2430; color:#e9cf96; font-family:'Cairo',sans-serif;
    font-weight:800; font-size:1.05rem; padding:12px 30px; border-radius:999px;
    box-shadow:0 14px 30px -12px rgba(16,22,29,.45); }
  @media(max-width:749px){
    .lpp__grid{ grid-template-columns:repeat(2,1fr); }
    .lpp__heading{ font-size:1.3rem; }
  }
</style>

{% schema %}
{
  "name": "LP — المشكلة",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "ركبتك صارت توقفك عن حياتك؟" },
    { "type": "text", "id": "subheading", "label": "العنوان الفرعي", "default": "إذا تحس بواحدة من هذي، هذا المنتج لك" }
  ],
  "blocks": [
    {
      "type": "pain",
      "name": "نقطة ألم",
      "settings": [
        { "type": "text", "id": "icon", "label": "إيموجي", "default": "🪜" },
        { "type": "textarea", "id": "text", "label": "النص", "default": "صعود الدرج صار عذاب" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "LP — المشكلة", "blocks": [ { "type": "pain" }, { "type": "pain" }, { "type": "pain" }, { "type": "pain" } ] } ]
}
{% endschema %}
