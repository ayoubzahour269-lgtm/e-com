/* Bénéfices */
.bm-ben-grid{display:grid;gap:12px}
.bm-ben{display:flex;gap:12px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);
  border-radius:var(--radius);padding:var(--s2) var(--s3)}
