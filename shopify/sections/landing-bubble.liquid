.bm-form{background:var(--ivory);border:1px solid var(--line);border-radius:var(--radius);padding:var(--s3)}
.bm-field{display:grid;gap:6px;margin-bottom:14px}
.bm-field label{font-size:14px;font-weight:700;color:var(--forest)}
.bm-field input,.bm-field select,.bm-field textarea{font-family:var(--body);font-size:16px;padding:14px 15px;
  border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);width:100%}
