{% comment %} Bloc commande premium — EasySell d'abord, fallback add-to-cart stylé {% endcomment %}
<div class="lpor" dir="rtl" id="lp-order">
  <div class="lpor__container">
    <h2 class="lpor__heading lpx-reveal">{{ section.settings.heading }}</h2>
    <p class="lpor__sub lpx-reveal">{{ section.settings.subheading }}</p>

    <div class="lpor__card lpx-reveal" data-delay="120">
      {% if section.settings.ribbon != blank %}<div class="lpor__ribbon">{{ section.settings.ribbon }}</div>{% endif %}
      <div class="lpor__product">
        <div class="lpor__name">{{ section.settings.product_label | default: product.title }}</div>
        <div class="lpor__prices">
          {% assign _p = product.price | divided_by: 100 %}
          <span class="lpor__price">{{ _p }} <small>ر.س</small></span>
          {% if product.compare_at_price > product.price %}
            {% assign _c = product.compare_at_price | divided_by: 100 %}
            <s class="lpor__was">{{ _c }} ر.س</s>
            {% assign saved = product.compare_at_price | minus: product.price %}
            {% assign _s = saved | divided_by: 100 %}
            <span class="lpor__save">وفّري {{ _s }} ر.س</span>
          {% endif %}
        </div>
        <div class="lpor__note">{{ section.settings.note }}</div>
      </div>

      {%- comment -%} EasySell : Form display → Embedded → Custom selector → #easysell-form-here {%- endcomment -%}
      <div id="easysell-form-here"></div>

      <form method="post" action="/cart/add" id="lpor-fallback" class="lpor__fallback" style="display:none">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="return_to" value="/checkout">
        <div class="lpor__qtyrow">
          <span>الكمية</span>
          <div class="lpor__qty">
            <button type="button" aria-label="أنقصي الكمية" onclick="var q=document.getElementById('lpor-q');q.value=Math.max(1,+q.value-1)">−</button>
            <input id="lpor-q" name="quantity" type="number" inputmode="numeric" min="1" value="1">
            <button type="button" aria-label="زيدي الكمية" onclick="var q=document.getElementById('lpor-q');q.value=+q.value+1">+</button>
          </div>
        </div>
        <button type="submit" class="lpor__btn lpx-shimmer">أكملي الطلب — الدفع عند الاستلام</button>
      </form>

      <div class="lpor__chips">
        <span>الدفع عند الاستلام</span><i>·</i><span>توصيل مجاني 2–5 أيام</span><i>·</i><span>تأكيد هاتفي قبل الإرسال</span>
      </div>
    </div>
  </div>
</div>

<script>
  (function(){
    var anchor = document.getElementById('easysell-form-here');
    var fb = document.getElementById('lpor-fallback');
    if (!anchor || !fb) return;
    function hasES(){ return anchor.children.length > 0 || document.querySelector('easysell-form, .easysell-form, [class*="easysell"] form'); }
    function sync(){ fb.style.display = hasES() ? 'none' : fb.style.display; }
    if ('MutationObserver' in window) new MutationObserver(sync).observe(anchor, { childList: true, subtree: true });
    setTimeout(function(){ if (!hasES()) fb.style.display = 'block'; }, 3500);
    setInterval(sync, 2000);
  })();
</script>

<style>
  .lpor{ background:var(--lpx-wave,#faf7f2); padding:52px 16px 58px; }
  .lpor__container{ max-width:640px; margin-inline:auto; text-align:center; }
  .lpor__heading{ font-family:'Cairo',sans-serif; font-size:1.7rem; font-weight:900; margin:0 0 8px; color:#241512; }
  .lpor__sub{ color:#7a675f; margin:0 0 24px; line-height:1.9; }
  .lpor__card{ background:#fff; border-radius:22px; padding:26px 22px 24px; text-align:start;
    border-top:5px solid var(--lpx-gold,#c9a557); box-shadow:0 24px 60px -28px rgba(36,21,18,.25); }
  .lpor__ribbon{ background:linear-gradient(135deg,#dcb96a,#c9a557); color:#2b1f06; font-weight:800; font-size:.85rem;
    text-align:center; border-radius:10px; padding:7px 12px; margin-bottom:14px; }
  .lpor__name{ font-family:'Cairo',sans-serif; font-weight:800; font-size:1.08rem; color:#241512; margin-bottom:6px; }
  .lpor__prices{ display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
  .lpor__price{ font-family:'Cairo',sans-serif; font-weight:900; font-size:2rem; color:#8E1B1E; }
  .lpor__price small{ font-size:1rem; }
  .lpor__was{ color:#a89a93; font-size:1rem; }
  .lpor__save{ background:#f7ecd8; color:#7a5c14; font-weight:800; font-size:.78rem; padding:4px 12px; border-radius:8px; }
  .lpor__note{ color:#7a675f; font-size:.88rem; margin:6px 0 16px; }
  .lpor__qtyrow{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; font-weight:700; color:#241512; }
  .lpor__qty{ display:flex; align-items:center; border:1.5px solid #e8ddd4; border-radius:12px; overflow:hidden; }
  .lpor__qty button{ width:44px; height:44px; border:none; background:#faf6f1; font-size:1.3rem; cursor:pointer; color:#241512; }
  .lpor__qty input{ width:56px; height:44px; border:none; text-align:center; font-size:1rem; font-weight:700; -moz-appearance:textfield; }
  .lpor__qty input::-webkit-inner-spin-button{ -webkit-appearance:none; }
  .lpor__btn{ width:100%; font-family:'Cairo',sans-serif; font-weight:800; font-size:1.05rem; line-height:1.5;
    background:linear-gradient(135deg,#dcb96a,#c9a557 55%,#b8923f); color:#2b1f06;
    border:none; border-radius:14px; padding:15px 22px; cursor:pointer;
    box-shadow:0 14px 30px -10px rgba(184,146,63,.55); transition:transform .18s ease, box-shadow .18s ease; }
  .lpor__btn:hover{ transform:translateY(-2px); box-shadow:0 18px 36px -10px rgba(184,146,63,.7); }
  .lpor__chips{ display:flex; justify-content:center; align-items:center; gap:8px; flex-wrap:wrap;
    margin-top:16px; color:#7a675f; font-size:.82rem; font-weight:600; }
  .lpor__chips i{ font-style:normal; color:#c9a557; }
</style>

{% schema %}
{
  "name": "LP — الطلب",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "أكملي طلبك الآن" },
    { "type": "text", "id": "subheading", "label": "تحت العنوان", "default": "املئي معلوماتك وسنتصل بك لتأكيد الطلب — بدون أي دفع مسبق" },
    { "type": "text", "id": "product_label", "label": "اسم المنتج المعروض" },
    { "type": "text", "id": "ribbon", "label": "شريط أعلى البطاقة" },
    { "type": "text", "id": "note", "label": "ملاحظة تحت السعر", "default": "شامل التوصيل — الدفع كاش أو شبكة عند الاستلام" }
  ],
  "presets": [ { "name": "LP — الطلب" } ]
}
{% endschema %}
