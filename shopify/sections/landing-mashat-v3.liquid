{% comment %} Landing Mashat V3 — port hifi du design handoff (charte ivoire/bordeaux/or, Amiri + IBM Plex Arabic) {% endcomment %}
{%- assign gold_grad = 'linear-gradient(135deg,#E3C05C,#C9A227 45%,#9A7514)' -%}

<div class="m3" dir="rtl">

  <!-- Bandeau annonce -->
  <div class="m3-announce">{{ section.settings.announce }}</div>

  <!-- Header sticky -->
  <header class="m3-header">
    <div class="m3-logo"><span class="m3-wordmark">مشاط</span><span class="m3-latin">MASHAT</span></div>
    <a href="#order" class="m3-cta-pill">اطلبي الآن</a>
  </header>

  <!-- HERO -->
  <section class="m3-hero">
    <div class="m3-hero-copy">
      <span class="m3-badge">أعشاب طبيعية ١٠٠٪ — بلا بارابين ولا سيليكون</span>
      <h1 class="m3-h1">{{ section.settings.h1_line1 }}<br><span class="m3-h1-gold">{{ section.settings.h1_line2 }}</span></h1>
      <p class="m3-lead">{{ section.settings.lead }}</p>
      <div class="m3-price-row">
        <span class="m3-price">139 <small>ر.س</small></span>
        <span class="m3-was">185 ر.س</span>
        <span class="m3-promo">خصم 25٪</span>
      </div>
      <a href="#order" class="m3-cta-big">اطلبي الآن — الدفع عند الاستلام</a>
      <div class="m3-proofs">
        <span>✓ توصيل مجاني ٢–٥ أيام</span><span>✓ تأكيد هاتفي قبل الشحن</span><span>✓ فحص المنتج قبل الدفع</span>
      </div>
    </div>
    <div class="m3-hero-visual">
      <div class="m3-hero-card" id="m3-tilt">
        <img src="{{ 'mechat-v3-hero.webp' | asset_url }}" alt="عبوة ٣ قوارير زيت المشاط الأحمر" loading="eager">
        <span class="m3-hero-badge">عبوة ٣ قوارير — عناية ٩٠ يومًا</span>
      </div>
    </div>
  </section>

  <!-- BÉNÉFICES -->
  <section class="m3-benefits">
    <div class="m3-container">
      <div data-reveal class="m3-center"><h2 class="m3-h2">لماذا زيت المشاط الأحمر؟</h2><div class="m3-rule"></div></div>
      <div class="m3-grid270">
        {% assign btitles = 'جذور أقوى|تساقط أقل|كثافة وطول|ترطيب عميق|لمعان حريري|لكل أنواع الشعر' | split: '|' %}
        {% assign btexts = 'يغذي فروة الرأس ويقوي بصيلات الشعر من العمق|يقلّل التساقط الملحوظ ويقوي الشعر الضعيف|يدعم نمو الشعر ويمنحه كثافة وطولًا مع المواظبة|يرطب الشعر ويقلل الجفاف والتقصف والهيشان|يمنح الشعر لمعانًا طبيعيًا ونعومة ورائحة لطيفة|مناسب لجميع أنواع الشعر حتى المصبوغ' | split: '|' %}
        {% for i in (0..5) %}
        <div data-reveal class="m3-bcard">
          <span class="m3-bt"><span class="m3-check">✓</span>{{ btitles[i] }}</span>
          <span class="m3-bx">{{ btexts[i] }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- INGRÉDIENTS -->
  <section class="m3-ing m3-container">
    <div data-reveal class="m3-center"><h2 class="m3-h2">أربعة كنوز طبيعية</h2><div class="m3-rule"></div></div>
    <div class="m3-grid210">
      {% assign ings = 'mechat,المشاط,عشبة عريقة تُقوّي الجذور من العمق|hibiscus,الكركديه,يمنح الزيت لونه الياقوتي ويغذي الخصلة|henna,الحنّاء,تغلّف الشعرة وتزيد كثافتها الظاهرة|lemon,الليمون,ينقّي فروة الرأس ويمنح انتعاشًا' | split: '|' %}
      {% for ing in ings %}
        {% assign p = ing | split: ',' %}
        <div data-reveal class="m3-ingcard">
          <img src="{{ 'mechat-v3-ing-' | append: p[0] | append: '.webp' | asset_url }}" alt="{{ p[1] }}" loading="lazy">
          <div class="m3-ing-grad"></div>
          <div class="m3-ing-txt"><span class="m3-ing-name">{{ p[1] }}</span><span class="m3-ing-desc">{{ p[2] }}</span></div>
        </div>
      {% endfor %}
    </div>
  </section>

  <!-- VIDÉO -->
  <section class="m3-video">
    <video id="m3video" src="{{ 'mechat-v3-video.mp4' | asset_url }}" autoplay loop muted playsinline></video>
    <div class="m3-video-overlay"></div>
    <div data-reveal class="m3-video-copy">
      <span class="m3-video-title">قطرةٌ واحدة…<br><span>وتبدأ الحكاية</span></span>
      <span class="m3-video-sub">زيتٌ خفيفٌ يتغلغل في كل خصلة، من الجذر إلى الطرف — فتعود الكثافة، ويعود اللمعان.</span>
    </div>
  </section>

  <!-- AVANT / APRÈS -->
  <section class="m3-ba-sec">
    <div data-reveal class="m3-center"><h2 class="m3-h2">اسحبي وشاهدي الفرق</h2><div class="m3-rule"></div></div>
    <div data-reveal class="m3-ba" id="m3ba" dir="ltr">
      <img class="m3-ba-before" src="{{ 'mechat-ba-before.webp' | asset_url }}" alt="قبل" draggable="false">
      <div class="m3-ba-clip" id="m3baClip">
        <img class="m3-ba-after" id="m3baAfter" src="{{ 'mechat-ba-after.webp' | asset_url }}" alt="بعد" draggable="false">
      </div>
      <div class="m3-ba-line" id="m3baLine"><div class="m3-ba-knob">⇆</div></div>
      <span class="m3-ba-lab m3-ba-lab-after">بعد</span>
      <span class="m3-ba-lab m3-ba-lab-before">قبل</span>
    </div>
    <p class="m3-ba-note">صورة توضيحية — مع الاستخدام المنتظم والعناية بالتصفيف</p>
  </section>

  <!-- RITUEL -->
  <section class="m3-ritual">
    <div class="m3-container">
      <div data-reveal class="m3-center"><h2 class="m3-h2 m3-h2-gold">طقس العناية الطبيعي — أربع خطوات</h2><div class="m3-rule"></div></div>
      <div class="m3-grid210 m3-gap18">
        {% assign steps = '١,ضعي الزيت على فروة الرأس وطول الشعر|٢,دلّكي بلطف واتركيه من 4 إلى 8 ساعات|٣,اغسلي الشعر بشامبو مناسب حتى يزول الزيت|٤,كرّري 2–3 مرات في الأسبوع لمدة ٩٠ يومًا' | split: '|' %}
        {% for st in steps %}
          {% assign p = st | split: ',' %}
          <div data-reveal class="m3-step">
            <div class="m3-step-img">
              <img src="{{ 'mechat-v3-step' | append: forloop.index | append: '.webp' | asset_url }}" alt="خطوة {{ p[0] }}" loading="lazy">
              <span class="m3-step-num">{{ p[0] }}</span>
            </div>
            <span class="m3-step-txt">{{ p[1] }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- AVIS -->
  <section class="m3-reviews m3-container">
    <div data-reveal class="m3-center">
      <h2 class="m3-h2">آراء عميلاتنا</h2>
      <p class="m3-rev-sub">صور حقيقية من طلبات عميلاتنا</p>
      <div class="m3-rule"></div>
    </div>
    <div class="m3-grid270">
      {% assign revs = 'ugc1,أم ريان — الرياض,★★★★★,بعد ثلاثة أسابيع من الاستخدام المنتظم لاحظتُ أن شعري أصبح أقوى وأكثر لمعانًا، والزيت خفيف لا يُثقل الشعر.|ugc2,نورة — جدة,★★★★★,التساقط قلّ بشكل ملحوظ منذ الأسبوع الثاني. طلبتُ عبوة ثانية لوالدتي، والتوصيل وصل خلال ثلاثة أيام.|ugc3,أم فهد — الدمام,★★★★☆,شعري مصبوغ وكنت مترددة، لكنه رطّبه وخفف الهيشان بوضوح. رائحته لطيفة وغير نفّاذة.' | split: '|' %}
      {% for r in revs %}
        {% assign p = r | split: ',' %}
        <div data-reveal class="m3-rev">
          <img src="{{ 'mechat-' | append: p[0] | append: '.webp' | asset_url }}" alt="صورة عميلة" loading="lazy">
          <div class="m3-rev-body">
            <div class="m3-rev-head"><span class="m3-rev-name">{{ p[1] }}</span><span class="m3-stars">{{ p[2] }}</span></div>
            <p class="m3-rev-txt">{{ p[3] }}</p>
            <span class="m3-rev-tag">✓ طلب مؤكد — الدفع عند الاستلام</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <!-- COMMANDE -->
  <section id="order" class="m3-order m3-container">
    <div data-reveal class="m3-center"><h2 class="m3-h2">اختاري عرضك واطلبي الآن</h2><div class="m3-rule"></div></div>
    <div class="m3-order-grid">
      <div class="m3-packs">
        <div data-reveal class="m3-pack m3-pack-on" id="m3p1" onclick="m3Pick(1)">
          <span class="m3-pack-badge" style="background:{{ gold_grad }};color:#2E1D07;">خصم 25٪</span>
          <span class="m3-radio m3-radio-on" id="m3r1"></span>
          <img src="{{ 'mechat-pack3.webp' | asset_url }}" alt="عبوة ٣ قوارير">
          <div class="m3-pack-mid"><span class="m3-pack-t">عبوة ٣ قوارير × 250 مل</span><span class="m3-pack-s">عناية متكاملة ٩٠ يومًا</span></div>
          <div class="m3-pack-price"><span class="m3-pp">139 ر.س</span><span class="m3-pw">185 ر.س</span></div>
        </div>
        <div data-reveal class="m3-pack" id="m3p2" onclick="m3Pick(2)">
          <span class="m3-pack-badge" style="background:#A32638;color:#FFF;">الأكثر توفيرًا</span>
          <span class="m3-radio" id="m3r2"></span>
          <img src="{{ 'mechat-pack-podium.webp' | asset_url }}" alt="عبوتان">
          <div class="m3-pack-mid"><span class="m3-pack-t">عبوتان — ٦ قوارير</span><span class="m3-pack-s m3-green">وفّري 19 ر.س إضافية — لكِ ولوالدتك</span></div>
          <div class="m3-pack-price"><span class="m3-pp">259 ر.س</span><span class="m3-pw">370 ر.س</span></div>
        </div>
        <div data-reveal class="m3-recap">
          <div><span>المحتوى</span><span>٣ قوارير × 250 مل لكل عبوة</span></div>
          <div><span>المكونات</span><span>مشاط، كركديه، حنّاء، ليمون</span></div>
          <div><span>الاستخدام</span><span>خارجي للشعر فقط</span></div>
        </div>
      </div>
      <div data-reveal class="m3-form-card">
        <div class="m3-center m3-form-head">
          <span class="m3-form-title">اطلبي الآن</span>
          <span class="m3-form-sub">املئي البيانات وسنتصل بكِ للتأكيد — لا دفع إلكتروني</span>
        </div>
        {%- comment -%} EasySell : Form display → Embedded → Custom selector → #easysell-form-here {%- endcomment -%}
        <div id="easysell-form-here"></div>
        <form method="post" action="/cart/add" id="m3-fallback" style="display:none">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" id="m3qty" value="1">
          <input type="hidden" name="return_to" value="/checkout">
          <button type="submit" class="m3-submit" id="m3sub">تأكيد الطلب — 139 ر.س</button>
        </form>
        {% if section.settings.whatsapp != blank %}
        <a class="m3-wa" href="https://wa.me/{{ section.settings.whatsapp }}?text={{ 'أرغب بطلب زيت المشاط الأحمر' | url_encode }}">اطلبي عبر واتساب</a>
        {% endif %}
        <div class="m3-lock">🔒 بياناتكِ محفوظة — الدفع عند الاستلام فقط</div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="m3-faq">
    <div data-reveal class="m3-center"><h2 class="m3-h2">أسئلة شائعة</h2><div class="m3-rule"></div></div>
    <div class="m3-faq-list">
      <details data-reveal><summary>كيف يتم الدفع والتوصيل؟</summary><p>الدفع عند الاستلام — تدفعين للمندوب عند وصول الطلب. التوصيل مجاني خلال ٢ إلى ٥ أيام لجميع مدن المملكة، مع تأكيد هاتفي قبل الشحن.</p></details>
      <details data-reveal><summary>هل يناسب الشعر المصبوغ؟</summary><p>نعم — تركيبته طبيعية ١٠٠٪ (مشاط، كركديه، حنّاء، ليمون)، بلا بارابين ولا سيليكون، ومناسبة لجميع أنواع الشعر حتى المصبوغ.</p></details>
      <details data-reveal><summary>متى تظهر النتيجة؟</summary><p>مع الاستخدام المنتظم 2–3 مرات في الأسبوع، تلاحظ أغلب العميلات فرقًا في اللمعان والنعومة خلال الأسابيع الأولى، بينما تحتاج الكثافة وتقليل التساقط الملحوظ إلى المواظبة ٩٠ يومًا — وهي مدة العبوة الكاملة.</p></details>
      <details data-reveal><summary>هل يمكنني فحص المنتج قبل الدفع؟</summary><p>نعم، يمكنكِ فحص الطلب أمام المندوب قبل الدفع.</p></details>
    </div>
  </section>

  <!-- Footer -->
  <footer class="m3-footer">
    <span class="m3-f-mark">مشاط</span>
    <span class="m3-f-latin">MASHAT</span>
    <div class="m3-rule"></div>
    <span class="m3-f-note">زيت المشاط الأحمر — استخدام خارجي للشعر فقط</span>
  </footer>

  <!-- STICKY BAR -->
  <div class="m3-sticky" id="m3sticky" dir="rtl">
    <div class="m3-sticky-price"><span id="m3sPrice">139 ر.س</span><span id="m3sOld">185 ر.س</span></div>
    <a href="#order" class="m3-sticky-cta">اطلبي الآن</a>
  </div>

</div>

<script>
(function(){
  /* Reveal au scroll */
  var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
  els.forEach(function(el, i){
    el.style.opacity = '0'; el.style.transform = 'translateY(26px)';
    el.style.transition = 'opacity .75s cubic-bezier(.22,.9,.3,1) ' + ((i % 5) * 70) + 'ms, transform .75s cubic-bezier(.22,.9,.3,1) ' + ((i % 5) * 70) + 'ms';
  });
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if (e.isIntersecting){ e.target.style.opacity='1'; e.target.style.transform='none'; io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  els.forEach(function(el){ io.observe(el); });

  /* Vidéo toujours muette */
  var hv = document.getElementById('m3video');
  if (hv){ hv.defaultMuted = true; hv.muted = true; hv.volume = 0; hv.play().catch(function(){}); }

  /* Tilt héro (desktop) */
  var card = document.getElementById('m3-tilt');
  if (card && matchMedia('(pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches){
    var tx=0, ty=0, cx=0, cy=0;
    card.addEventListener('mousemove', function(e){
      var r = card.getBoundingClientRect();
      tx = ((e.clientX - r.left)/r.width - .5) * 10;   /* rotateY ±5 */
      ty = ((e.clientY - r.top)/r.height - .5) * -8;   /* rotateX ±4 */
    });
    card.addEventListener('mouseleave', function(){ tx=0; ty=0; });
    (function tick(){
      cx += (tx-cx)*0.08; cy += (ty-cy)*0.08;
      card.style.transform = 'perspective(900px) rotateY(' + cx + 'deg) rotateX(' + cy + 'deg)';
      requestAnimationFrame(tick);
    })();
  }

  /* Slider avant/après */
  var ba = document.getElementById('m3ba'), clip = document.getElementById('m3baClip'),
      line = document.getElementById('m3baLine'), after = document.getElementById('m3baAfter');
  function baSet(p){
    p = Math.max(4, Math.min(96, p));
    clip.style.width = p + '%'; line.style.left = p + '%';
    after.style.width = ba.clientWidth + 'px';
  }
  if (ba){
    baSet(50);
    window.addEventListener('resize', function(){ baSet(parseFloat(clip.style.width)||50); });
    var drag = false;
    function move(e){
      if (!drag) return;
      var x = (e.touches ? e.touches[0].clientX : e.clientX) - ba.getBoundingClientRect().left;
      baSet(x / ba.clientWidth * 100);
    }
    ba.addEventListener('pointerdown', function(e){ drag = true; ba.setPointerCapture(e.pointerId); move(e); });
    ba.addEventListener('pointermove', move);
    ba.addEventListener('pointerup', function(){ drag = false; });
    ba.addEventListener('pointercancel', function(){ drag = false; });
  }

  /* Sélecteur de packs + prix synchronisés */
  window.m3Pick = function(n){
    var p1 = document.getElementById('m3p1'), p2 = document.getElementById('m3p2');
    var r1 = document.getElementById('m3r1'), r2 = document.getElementById('m3r2');
    var one = n === 1;
    p1.classList.toggle('m3-pack-on', one);  p2.classList.toggle('m3-pack-on', !one);
    r1.classList.toggle('m3-radio-on', one); r2.classList.toggle('m3-radio-on', !one);
    var price = one ? '139 ر.س' : '259 ر.س', old = one ? '185 ر.س' : '370 ر.س';
    document.getElementById('m3qty').value = one ? 1 : 2;
    document.getElementById('m3sub').textContent = 'تأكيد الطلب — ' + price;
    document.getElementById('m3sPrice').textContent = price;
    document.getElementById('m3sOld').textContent = old;
  };

  /* Sticky bar après 600px */
  var sticky = document.getElementById('m3sticky');
  window.addEventListener('scroll', function(){
    sticky.classList.toggle('m3-sticky-on', window.scrollY > 600);
  }, { passive: true });

  /* Fallback si EasySell absent */
  var anchor = document.getElementById('easysell-form-here'), fb = document.getElementById('m3-fallback');
  function hasES(){ return anchor.children.length > 0 || document.querySelector('easysell-form, .easysell-form, [class*="easysell"] form'); }
  if ('MutationObserver' in window) new MutationObserver(function(){ if (hasES()) fb.style.display = 'none'; }).observe(anchor, { childList: true, subtree: true });
  setTimeout(function(){ if (!hasES()) fb.style.display = 'block'; }, 3500);
})();
</script>

<style>
  .m3{min-height:100vh;background:#F8F2E6;padding-bottom:86px}
  .m3-container{max-width:1120px;margin:0 auto;padding:80px 24px}
  .m3-center{text-align:center}
  .m3-h2{margin:0 0 8px;font-family:'Amiri',serif;font-weight:700;font-size:clamp(27px,3.6vw,38px);color:#5E1322}
  .m3-h2-gold{color:#F5DE8C}
  .m3-rule{width:90px;height:1px;background:linear-gradient(90deg,transparent,#C9A227,transparent);margin:0 auto 40px}

  .m3-announce{background:#5E1322;color:#F1E3C2;text-align:center;padding:9px 16px;font-size:13px;font-weight:600}
  .m3-header{background:rgba(248,242,230,.9);backdrop-filter:blur(8px);border-bottom:1px solid #EADFC6;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px;position:sticky;top:0;z-index:40}
  .m3-logo{display:flex;align-items:center;gap:9px}
  .m3-wordmark{font-family:'Amiri',serif;font-weight:700;font-size:27px;color:#5E1322;line-height:1}
  .m3-latin{font-size:9px;letter-spacing:4px;color:#8A7660;align-self:flex-end;padding-bottom:3px}
  .m3-cta-pill{display:flex;align-items:center;justify-content:center;height:42px;padding:0 24px;border-radius:999px;background:linear-gradient(135deg,#E3C05C,#C9A227 45%,#9A7514);color:#2E1D07;font-size:14px;font-weight:700;transition:transform .18s}
  .m3-cta-pill:hover{transform:translateY(-1px);color:#2E1D07}

  .m3-hero{max-width:1120px;margin:0 auto;padding:48px 24px 64px;display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:44px;align-items:center}
  .m3-hero-copy{display:flex;flex-direction:column;gap:20px;animation:heroIn .9s cubic-bezier(.22,.9,.3,1) both}
  .m3-badge{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(201,162,39,.5);background:rgba(201,162,39,.08);color:#6E4A0E;font-size:12px;font-weight:700;padding:7px 16px;border-radius:999px;letter-spacing:.5px}
  .m3-h1{margin:0;font-family:'Amiri',serif;font-weight:700;font-size:clamp(34px,4.6vw,56px);line-height:1.4;color:#5E1322}
  .m3-h1-gold{background:linear-gradient(135deg,#B08415,#C9A227 55%,#8F6B12);-webkit-background-clip:text;background-clip:text;color:transparent}
