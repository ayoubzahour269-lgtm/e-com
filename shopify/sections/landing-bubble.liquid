.bm-field[data-invalid] .err{display:block}
.bm-field[data-invalid] input,.bm-field[data-invalid] select{border-color:#A81E1E}
.bm-form-note{font-size:13px;color:var(--muted);text-align:center;margin-top:12px;line-height:1.8}
.bm-ok{display:none;text-align:center;padding:var(--s4) var(--s2)}
