.bm-qty{display:grid;gap:10px}
.bm-qty label{position:relative;display:flex;align-items:center;gap:12px;border:2px solid var(--line);
  background:var(--surface);border-radius:14px;padding:14px 16px;cursor:pointer;transition:border-color .16s,box-shadow .16s}
.bm-qty label:has(input:checked){border-color:var(--brass);box-shadow:0 0 0 3px rgba(185,138,46,.16)}
