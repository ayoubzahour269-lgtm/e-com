    "lp_reviews": {
      "type": "landing-reviews",
      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "stars": 5,
            "image_asset": "",
            "text": "شعري كان يتساقط بشكل يخوّف مع كل تمشيطة. بعد شهر ونص التساقط قل بشكل واضح وصارت له لمعة حلوة. الطلب وصل الرياض بسرعة.",
            "name": "أم ريان",
            "city": "الرياض"
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "stars": 5,
            "image_asset": "",
            "text": "ريحته خفيفة وما يثقّل الشعر أبدًا. بنتي شعرها خفيف وبان لها شعر جديد صغير من الشهر الثاني. بطلب باك ثاني أكيد.",
            "name": "نورة ع.",
            "city": "جدة"
