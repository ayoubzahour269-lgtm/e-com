{% comment %} Grille de bénéfices — icônes/images + titre + texte {% endcomment %}
<div class="lp-benefits" dir="rtl">
  <div class="lp-benefits__container">
    {% if section.settings.heading != blank %}
      <h2 class="lp-benefits__heading">{{ section.settings.heading }}</h2>
      <div class="lpx-divider"><span class="d"></span></div>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="lp-benefits__sub">{{ section.settings.subheading }}</p>
    {% endif %}
    <div class="lp-benefits__grid lp-benefits__grid--{{ section.settings.columns }}">
      {% for block in section.blocks %}
        <div class="lp-benefits__card lpx-reveal" data-delay="{{ forloop.index0 | times: 100 }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img class="lp-benefits__img" src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="200" height="200">
          {% elsif block.settings.image_asset != blank %}
            <img class="lp-benefits__img lp-benefits__img--full" src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% elsif block.settings.emoji != blank %}
            <div class="lp-benefits__emoji">{{ block.settings.emoji }}</div>
          {% endif %}
          <h3 class="lp-benefits__title">{{ block.settings.title }}</h3>
          {% if block.settings.text != blank %}
            <p class="lp-benefits__text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .lp-benefits { background: {{ section.settings.bg_color }}; padding: 40px 16px; }
  .lp-benefits__container { max-width: 960px; margin: 0 auto; text-align: center; }
  .lp-benefits__heading { font-size: 1.6rem; font-weight: 800; margin: 0 0 8px; color: {{ section.settings.heading_color }}; }
  .lp-benefits__sub { font-size: 1rem; color: #666; margin: 0 0 28px; }
  .lp-benefits__grid { display: grid; gap: 20px; margin-top: 24px; }
  .lp-benefits__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .lp-benefits__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .lp-benefits__grid--4 { grid-template-columns: repeat(4, 1fr); }
  .lp-benefits__card { background: #fff; border-radius: 14px; padding: 20px 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
  .lp-benefits__img { width: 100%; max-width: 160px; height: auto; border-radius: 10px; margin: 0 auto 10px; display: block; object-fit: cover; }
  .lp-benefits__img--full { max-width: none; aspect-ratio: 1/1; border-radius: 12px; }
  .lp-benefits__emoji { font-size: 2.2rem; margin-bottom: 8px; }
  .lp-benefits__title { font-size: 1.02rem; font-weight: 700; margin: 0 0 6px; }
  .lp-benefits__text { font-size: 0.88rem; color: #555; margin: 0; line-height: 1.6; }
  @media (max-width: 749px) {
    .lp-benefits__grid--3, .lp-benefits__grid--4 { grid-template-columns: repeat(2, 1fr); }
    .lp-benefits__heading { font-size: 1.3rem; }
  }
</style>

{% schema %}
{
  "name": "LP — الفوائد",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "ليش تختارينه؟" },
    { "type": "text", "id": "subheading", "label": "العنوان الفرعي" },
    { "type": "select", "id": "columns", "label": "عدد الأعمدة", "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    { "type": "color", "id": "bg_color", "label": "لون الخلفية", "default": "#f7f5f2" },
    { "type": "color", "id": "heading_color", "label": "لون العنوان", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "فائدة",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "صورة (اختياري — بديل الإيموجي)" },
        { "type": "text", "id": "image_asset", "label": "أو اسم ملف من assets" },
        { "type": "text", "id": "emoji", "label": "إيموجي", "default": "✨" },
        { "type": "text", "id": "title", "label": "العنوان", "default": "فائدة رئيسية" },
        { "type": "textarea", "id": "text", "label": "الوصف" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "LP — الفوائد",
      "blocks": [
        { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
