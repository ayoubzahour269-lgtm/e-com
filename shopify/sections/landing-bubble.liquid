.bm-ok p{color:var(--muted)}
.bm-sent .bm-ok{display:block}
.bm-sent form,.bm-sent #easysell-form-here{display:none}
@media (min-width:900px){.bm-order-grid{grid-template-columns:.9fr 1.1fr;align-items:start}}

/* FAQ */
.bm-faq{max-width:780px}
.bm-faq details{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:10px}
