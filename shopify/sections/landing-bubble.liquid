  display:grid;place-items:center;font-style:normal;font-size:14px;font-weight:700;margin-top:3px}
.bm-ben b{display:block;font-family:var(--display);font-size:17px;color:var(--forest)}
.bm-ben span{font-size:14.5px;color:var(--muted)}
@media (min-width:768px){.bm-ben-grid{grid-template-columns:repeat(2,1fr)}}

/* Étapes */
.bm-steps{background:var(--surface)}
.bm-step-grid{display:grid;gap:var(--s3)}
.bm-step figure{margin:0}
.bm-step img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:var(--radius);box-shadow:var(--shadow)}
.bm-step figcaption{margin-top:14px}
.bm-step .n{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--brass);
  color:#22190A;font-weight:700;font-size:15px;margin-bottom:8px}
.bm-step b{display:block;font-family:var(--display);font-size:18px;color:var(--forest)}
