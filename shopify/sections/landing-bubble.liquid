{% comment %}
  Landing Bubble Mousse — généré depuis bubble.html par creative/bubble/port_to_shopify.py.
  Ne pas éditer à la main : modifier bubble.html puis relancer le script.
  Layout attendu : landing-bubble
{% endcomment %}

{%- assign p1 = section.settings.price_1 -%}
{%- assign p2 = section.settings.price_2 -%}
{%- assign p3 = section.settings.price_3 -%}
{%- assign was2 = p1 | times: 2 -%}
{%- assign was3 = section.settings.price_3_was -%}
{%- assign save2 = was2 | minus: p2 -%}
{%- assign off3 = was3 | minus: p3 | times: 100 | divided_by: was3 -%}

<div class="bm-root" dir="rtl">


<div class="bm-announce">{{ section.settings.announce }}</div>

<header class="bm-head">
  <div class="bm-logo"><b>بابل موس</b><span>BEIROU</span></div>
  <a href="#order" class="bm-pill">اطلبي الآن</a>
</header>

<main>
<!-- ============ HERO ============ -->
<section class="bm-hero">
  <img class="bm-hero-bg" src="{{ 'bubble-hero-bg.webp' | asset_url }}" alt="" aria-hidden="true">
  <div class="bm-hero-in">
    <div>
      <span class="bm-badge">◆ خلاصات نباتية — خالٍ من الأمونيا</span>
      <h1 class="bm-h1">{{ section.settings.h1_main }}<em>{{ section.settings.h1_gold }}</em></h1>
      <p class="bm-sub">{{ section.settings.lead }}</p>
      <div class="bm-price">
        <b data-price-now>{{ p3 }} <small>ر.س</small></b>
        <s data-price-was>{{ was3 }} ر.س</s>
        <i data-price-off>خصم {{ off3 }}٪</i>
      </div>
      <a href="#order" class="bm-cta">اطلبي الآن — الدفع عند الاستلام</a>
      <p class="bm-cta-note">عرض ٣ عبوات + زجاجة الزيت هدية</p>
      <div class="bm-hero-proof">
        <span>✓ تأكيد هاتفي قبل الشحن</span>
        <span>✓ توصيل ٢–٥ أيام</span>
        <span>✓ الدفع عند الاستلام</span>
      </div>
    </div>
    <div class="bm-hero-visual">
      <img src="{{ 'bubble-pack3.webp' | asset_url }}" width="900" height="1075" alt="عرض ٣ عبوات من صبغة الشعر الرغوية النباتية بابل موس، ٥٠٠ مل لكل عبوة" fetchpriority="high">
      <div class="bm-gift">هدية: <b>زجاجة الزيت</b> للتطبيق الدقيق</div>
    </div>
  </div>
</section>

<div class="bm-trust">
  <ul>
    <li><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>تغطية متساوية للشيب</li>
    <li><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>٢٥ دقيقة فقط</li>
    <li><svg viewBox="0 0 24 24"><path d="M12 3s7 4 7 9a7 7 0 0 1-14 0c0-5 7-9 7-9Z"/></svg>خالٍ من الأمونيا</li>
    <li><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>الدفع عند الاستلام</li>
  </ul>
</div>

<!-- ============ PROBLÈME ============ -->
<section class="bm-problem bm-sec">
  <div class="bm-wrap">
    <div class="bm-sec-head" data-reveal>
      <span class="bm-eyebrow">لماذا بابل موس</span>
      <h2 class="bm-h2">الجذور البيضاء تعود دائمًا قبل موعدها</h2>
      <p class="bm-lead">تقفين أمام المرآة صباحًا فترين الخط الأبيض عند المفرق مرة أخرى. الصالون بعيد وموعده متأخر، وعلبة الصبغة العادية تعني رائحة نفّاذة وقفازات وخطوات لا تنتهي.</p>
    </div>
    <div class="bm-problem-grid">
      <div class="bm-pain" data-reveal><b>وقت لا تملكينه</b><span>مواعيد الصالون وساعات الانتظار من أجل جذور تظهر من جديد بعد أسابيع.</span></div>
      <div class="bm-pain" data-reveal><b>رائحة تزعجك</b><span>الأمونيا ورائحتها النفّاذة التي تبقى في المنزل وفي الشعر بعد الغسيل.</span></div>
      <div class="bm-pain" data-reveal><b>نتيجة غير متساوية</b><span>خصلات تأخذ اللون وأخرى لا، وبقع أفتح عند الأطراف أو الجذور.</span></div>
    </div>
  </div>
</section>

<div class="bm-foam" aria-hidden="true"><svg viewBox="0 0 1440 60" preserveAspectRatio="none"><path fill="#FBF9F3" d="M0,60 L0,32 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 a30,30 0 0 1 60,0 L1440,60 Z" transform="scale(1,-1) translate(0,-60)"/></svg></div>

<!-- ============ RÉVÉLATEUR (interaction signature) ============ -->
<section class="bm-sec" id="reveal">
  <div class="bm-wrap">
    <div class="bm-sec-head" data-reveal>
      <span class="bm-eyebrow">الفرق بعينيك</span>
      <h2 class="bm-h2">اسحبي لترَي التغطية</h2>
      <div class="bm-rule"></div>
      <p class="bm-lead">حرّكي المقبض يمينًا ويسارًا لمقارنة الشعر قبل الاستعمال وبعده.</p>
    </div>
    <div class="bm-reveal" data-reveal id="revealBox">
      <img src="{{ 'bubble-ba-before.webp' | asset_url }}" alt="شعر بجذور بيضاء ظاهرة عند المفرق قبل الاستعمال" loading="lazy">
      <img class="bm-after" src="{{ 'bubble-ba-after.webp' | asset_url }}" alt="الشعر نفسه بلون أسود متجانس بعد الاستعمال" loading="lazy">
      <span class="bm-reveal-tag r">قبل</span>
      <span class="bm-reveal-tag l">بعد</span>
      <span class="bm-reveal-bar" id="revealBar"><span class="bm-reveal-knob">⇄</span></span>
      <input class="bm-range" id="revealRange" type="range" min="0" max="100" value="50" step="1"
             aria-label="مقارنة قبل وبعد">
    </div>
    <p class="bm-illus">صورة توضيحية — النتيجة تختلف حسب نوع الشعر ونسبة الشيب.</p>
  </div>
</section>

<!-- ============ ESSENCES ============ -->
<section class="bm-essences bm-sec" id="essences">
  <div class="bm-wrap">
    <div class="bm-sec-head" data-reveal>
      <span class="bm-eyebrow">HERBAL ESSENCES</span>
      <h2 class="bm-h2">أربع خلاصات نباتية</h2>
      <div class="bm-rule"></div>
      <p class="bm-lead">تركيبة نباتية خالية من الأمونيا، صُمّمت لتكون لطيفة على فروة الرأس أثناء التغطية.</p>
    </div>
    <div class="bm-ess-grid">
      <div class="bm-ess" data-reveal><img src="{{ 'bubble-ing-ginseng.webp' | asset_url }}" alt="جذر الجنسنغ" loading="lazy"><b>الجنسنغ</b><span>خلاصة الجنسنغ المعروفة في العناية التقليدية بالشعر.</span></div>
      <div class="bm-ess" data-reveal><img src="{{ 'bubble-ing-saponin.webp' | asset_url }}" alt="ثمار الصابون مصدر الصابونين" loading="lazy"><b>الصابونين</b><span>يمنح الرغوة قوامها الغني الذي ينساب على الخصلة.</span></div>
      <div class="bm-ess" data-reveal><img src="{{ 'bubble-ing-foti.webp' | asset_url }}" alt="جذر الفو-تي" loading="lazy"><b>الفو-تي</b><span>عشبة آسيوية عريقة ترتبط بالعناية بلون الشعر الداكن.</span></div>
      <div class="bm-ess" data-reveal><img src="{{ 'bubble-ing-sesame.webp' | asset_url }}" alt="بذور السمسم الأسود" loading="lazy"><b>السمسم الأسود</b><span>يُستعمل تقليديًا في وصفات العناية بالشعر الأسود.</span></div>
    </div>
  </div>
</section>

<!-- ============ BÉNÉFICES ============ -->
<section class="bm-sec" id="benefits">
  <div class="bm-wrap">
    <div class="bm-sec-head" data-reveal>
      <span class="bm-eyebrow">المميزات</span>
      <h2 class="bm-h2">ما الذي ستلاحظينه</h2>
      <div class="bm-rule"></div>
    </div>
    <div class="bm-ben-grid">
      <div class="bm-ben" data-reveal><i>✓</i><div><b>تغطية متساوية للشيب</b><span>من الجذور إلى الأطراف، بلون واضح ومتجانس.</span></div></div>
      <div class="bm-ben" data-reveal><i>✓</i><div><b>لون يبقى حيويًا بعد الغسيل</b><span>يحافظ على حيويته لفترة أطول بدل أن يبهت سريعًا.</span></div></div>
      <div class="bm-ben" data-reveal><i>✓</i><div><b>رائحة فواكه خفيفة</b><span>تدوم حتى ٩٦ ساعة على الشعر بدل رائحة الأمونيا.</span></div></div>
      <div class="bm-ben" data-reveal><i>✓</i><div><b>لطيفة على الفروة الحساسة</b><span>تركيبة نباتية خالية من الأمونيا.</span></div></div>
      <div class="bm-ben" data-reveal><i>✓</i><div><b>لمعة طبيعية ونعومة</b><span>تترك الشعر ناعمًا ومرنًا بعد الشطف.</span></div></div>
      <div class="bm-ben" data-reveal><i>✓</i><div><b>لكل أنواع الشعر</b><span>الطبيعي والكثيف والمجعّد على حدٍ سواء.</span></div></div>
    </div>
  </div>
</section>

<div class="bm-foam" aria-hidden="true"><svg viewBox="0 0 1440 60" preserveAspectRatio="none"><path fill="#FBF9F3" d="M0,0 L0,28 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 a30,30 0 0 0 60,0 L1440,0 Z"/></svg></div>

<!-- ============ ÉTAPES ============ -->
<section class="bm-steps bm-sec" id="howto">
  <div class="bm-wrap">
    <div class="bm-sec-head" data-reveal>
      <span class="bm-eyebrow">طريقة الاستعمال</span>
      <h2 class="bm-h2">ثلاث خطوات، كالشامبو تمامًا</h2>
      <div class="bm-rule"></div>
    </div>
    <div class="bm-step-grid">
      <div class="bm-step" data-reveal><figure><img src="{{ 'bubble-step1.webp' | asset_url }}" alt="وضع الرغوة على الشعر عند فروة الرأس" loading="lazy"><figcaption><span class="n">١</span><b>ضعي الرغوة</b><span>على الشعر بلطف، تمامًا كما تضعين الشامبو.</span></figcaption></figure></div>
      <div class="bm-step" data-reveal><figure><img src="{{ 'bubble-step2.webp' | asset_url }}" alt="توزيع الرغوة بالتساوي على أطوال الشعر" loading="lazy"><figcaption><span class="n">٢</span><b>وزّعيها بالتساوي</b><span>حتى تغطية الشعر بالكامل من الجذور إلى الأطراف.</span></figcaption></figure></div>
      <div class="bm-step" data-reveal><figure><img src="{{ 'bubble-step3.webp' | asset_url }}" alt="شطف الشعر بالماء الفاتر بعد انتهاء المدة" loading="lazy"><figcaption><span class="n">٣</span><b>اتركيها ثم اشطفي</b><span>٢٥ دقيقة، ثم شطف جيد بالماء الفاتر.</span></figcaption></figure></div>
    </div>
    <div class="bm-timer" data-reveal>⏱ النتيجة خلال ٢٥ دقيقة — بلا قفازات معقّدة ولا خطوات إضافية</div>
  </div>
</section>

<!-- ============ CONTENU DU LOT ============ -->
<section class="bm-sec" id="box">
  <div class="bm-wrap bm-box">
    <div data-reveal>
      <span class="bm-eyebrow">محتويات العرض</span>
      <h2 class="bm-h2" style="margin:10px 0 var(--s3)">ماذا يصلك في الطلب</h2>
      <ul class="bm-box-list">
        <li><i>٣</i><div><b>ثلاث عبوات ٥٠٠ مل</b><small>صبغة شعر رغوية نباتية — صلاحية ٣ سنوات.</small></div></li>
        <li><i>★</i><div><b>زجاجة الزيت — هدية</b><small>زجاجة بمشط للتطبيق السهل والدقيق عند الجذور.</small></div></li>
        <li><i>✓</i><div><b>لونك على اختيارك</b><small>تختارين اللون في نموذج الطلب أسفل الصفحة.</small></div></li>
      </ul>
      <div class="bm-colors">
        <span class="bm-swatch"><span style="background:#14120E"></span>أسود طبيعي</span>
        <span class="bm-swatch"><span style="background:#5B3A25"></span>بني كستنائي</span>
        <span class="bm-swatch"><span style="background:#3E2A1E"></span>بني كوفي</span>
        <span class="bm-swatch"><span style="background:#2B1D14"></span>بني داكن</span>
      </div>
    </div>
    <div data-reveal><img src="{{ 'bubble-bottle.webp' | asset_url }}" width="574" height="1374" alt="عبوة صبغة الشعر الرغوية النباتية بابل موس ٥٠٠ مل" loading="lazy" style="max-width:300px;margin-inline:auto"></div>
  </div>
</section>

<!-- ============ GARANTIE (remplace les avis tant qu'il n'y en a pas de réels) ============ -->
<section class="bm-guarantee">
  <div class="bm-wrap">
    <h2 data-reveal>تطلبين اليوم، وتدفعين عند الاستلام</h2>
    <p data-reveal>لا دفع مسبق ولا بطاقة بنكية. نتصل بكِ هاتفيًا لتأكيد الطلب واللون قبل الشحن، وتدفعين لمندوب التوصيل عند وصول الطلب إلى بابك.</p>
    <div class="bm-gua-grid">
      <div class="bm-gua" data-reveal><b>٠ ر.س</b><span>مقدمًا — الدفع عند الاستلام</span></div>
      <div class="bm-gua" data-reveal><b>٢–٥</b><span>أيام للتوصيل داخل المملكة</span></div>
      <div class="bm-gua" data-reveal><b>٥٠٠ مل</b><span>لكل عبوة — ٣ عبوات في العرض</span></div>
      <div class="bm-gua" data-reveal><b>٤</b><span>ألوان متاحة للاختيار</span></div>
    </div>
  </div>
</section>

<!-- ============ COMMANDE ============ -->
<section class="bm-order bm-sec" id="order">
  <div class="bm-wrap">
    <div class="bm-sec-head" data-reveal>
      <span class="bm-eyebrow">إتمام الطلب</span>
      <h2 class="bm-h2">اطلبي بابل موس الآن</h2>
      <div class="bm-rule"></div>
    </div>
    <div class="bm-order-grid">

      <div class="bm-offer" data-reveal>
        <h3>اختاري الكمية</h3>
        <div class="bm-qty">
          <label>
            <input type="radio" name="qty" value="1" data-total="{{ p1 }}">
            <span class="t"><b>عبوة واحدة</b><small>٥٠٠ مل</small></span>
            <span class="p"><span data-qp>{{ p1 }} ر.س</span></span>
          </label>
          <label>
            <input type="radio" name="qty" value="2" data-total="{{ p2 }}">
            <span class="t"><b>عبوتان</b><small>وفّري {{ save2 }} ر.س</small></span>
            <span class="p"><span data-qp>{{ p2 }} ر.س</span><s>{{ was2 }} ر.س</s></span>
          </label>
          <label>
            <span class="bm-tag">الأكثر طلبًا</span>
            <input type="radio" name="qty" value="3" data-total="{{ p3 }}" checked>
            <span class="t"><b>ثلاث عبوات + الهدية</b><small>زجاجة الزيت هدية</small></span>
            <span class="p"><span data-qp>{{ p3 }} ر.س</span><s>{{ was3 }} ر.س</s></span>
          </label>
        </div>
        <div class="bm-total"><span>الإجمالي</span><b id="totalOut">{{ p3 }} ر.س</b></div>
        <p class="bm-cta-note" style="text-align:start;margin-top:10px">التوصيل مجاني لجميع مدن المملكة.</p>
      </div>

      <div class="bm-form" data-reveal id="formWrap">
        <!-- EasySell (COD) se monte ici : Form display → Embedded → Custom selector → #easysell-form-here -->
        <div id="easysell-form-here"></div>

        <!-- Formulaire de repli, masqué automatiquement si EasySell se monte -->
        <form id="codForm" novalidate>
          <div class="bm-field">
            <label for="f-name">الاسم الكامل</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
            <span class="err">من فضلك اكتبي اسمك الكامل.</span>
          </div>
          <div class="bm-field">
            <label for="f-phone">رقم الجوال</label>
            <input id="f-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel"
                   placeholder="05XXXXXXXX" required>
            <span class="err">اكتبي رقم جوال سعودي صحيح، مثال: 0512345678</span>
          </div>
          <div class="bm-field">
            <label for="f-city">المدينة</label>
            <input id="f-city" name="city" type="text" autocomplete="address-level2" required>
            <span class="err">من فضلك اكتبي مدينتك.</span>
          </div>
          <div class="bm-field">
            <label for="f-address">العنوان بالتفصيل</label>
            <textarea id="f-address" name="address" rows="2" autocomplete="street-address" required></textarea>
            <span class="err">من فضلك اكتبي عنوان التوصيل.</span>
          </div>
          <div class="bm-field">
            <label for="f-color">اللون</label>
            <select id="f-color" name="color" required>
              <option value="أسود طبيعي">أسود طبيعي</option>
              <option value="بني كستنائي">بني كستنائي</option>
              <option value="بني كوفي">بني كوفي</option>
              <option value="بني داكن">بني داكن</option>
            </select>
            <span class="err">اختاري اللون.</span>
          </div>
          <input type="hidden" name="quantity" id="f-qty" value="3">
          <input type="hidden" name="total" id="f-total" value="{{ p3 }}">
          <button type="submit" class="bm-cta" id="submitBtn">اطلبي الآن — الدفع عند الاستلام</button>
          <p class="bm-form-note">لا دفع عبر الإنترنت — نتصل بكِ لتأكيد الطلب قبل الشحن.</p>
        </form>

        <div class="bm-ok" role="status">
          <b>تم استلام طلبك</b>
          <p>سيتصل بكِ فريقنا خلال ٢٤ ساعة لتأكيد الطلب واللون قبل الشحن.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="bm-sec" id="faq">
  <div class="bm-wrap bm-faq">
    <div class="bm-sec-head" data-reveal>
      <span class="bm-eyebrow">أسئلة شائعة</span>
      <h2 class="bm-h2">قبل أن تطلبي</h2>
      <div class="bm-rule"></div>
    </div>
    <details data-reveal><summary>هل تحتوي على أمونيا؟</summary><p>لا. التركيبة نباتية وخالية من الأمونيا، ولذلك لا تحمل رائحتها النفّاذة. كما هو الحال مع أي منتج للشعر، ننصح باختبار بسيط على خصلة صغيرة قبل الاستعمال الأول.</p></details>
    <details data-reveal><summary>كم من الوقت تستغرق؟</summary><p>٢٥ دقيقة من وضع الرغوة حتى الشطف. تُستعمل كالشامبو: توضع، تُوزّع، تُترك، ثم تُشطف بالماء الفاتر.</p></details>
    <details data-reveal><summary>هل تغطي الشعر الأبيض فعلًا؟</summary><p>نعم، التغطية متساوية وواضحة من الجذور إلى الأطراف. تختلف درجة النتيجة حسب نوع الشعر ونسبة الشيب، ويمكن تكرار الاستعمال حسب الحاجة للحفاظ على اللون.</p></details>
    <details data-reveal><summary>هل تناسب فروة الرأس الحساسة؟</summary><p>التركيبة نباتية ولطيفة وخالية من الأمونيا. إن كانت لديكِ حساسية معروفة أو مشكلة جلدية في فروة الرأس، استشيري مختصًا قبل الاستعمال وابدئي باختبار على مساحة صغيرة.</p></details>
    <details data-reveal><summary>كيف أختار اللون المناسب؟</summary><p>تتوفر أربعة ألوان: أسود طبيعي، بني كستنائي، بني كوفي، وبني داكن. تختارين اللون في نموذج الطلب، ويؤكده معكِ فريقنا في مكالمة التأكيد قبل الشحن.</p></details>
    <details data-reveal><summary>كيف يتم الدفع والتوصيل؟</summary><p>الدفع عند الاستلام نقدًا لمندوب التوصيل، دون أي دفع مسبق. التوصيل خلال ٢–٥ أيام لجميع مدن المملكة، ويسبقه اتصال هاتفي للتأكيد.</p></details>
  </div>
</section>
</main>

