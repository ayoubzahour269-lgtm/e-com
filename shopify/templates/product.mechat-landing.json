    "lp_faq": {
      "type": "landing-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "كيف أدفع؟",
            "answer": "<p>الدفع عند الاستلام — تدفعين كاش أو شبكة للمندوب لما يوصلك الطلب. ولا ريال قبل ما تستلمين.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "متى يوصل الطلب؟",
            "answer": "<p>التوصيل خلال ٢ إلى ٥ أيام عمل لجميع مدن المملكة، والتوصيل مجاني ١٠٠٪.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "هل يناسب كل أنواع الشعر؟",
            "answer": "<p>نعم — الجاف والدهني والمصبوغ والمعالج. تركيبته طبيعية 100% وخالية من البارابين والسيليكون.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "هل يصبغ الشعر بالأحمر؟",
            "answer": "<p>لا. اللون الأحمر من الكركديه والأعشاب الطبيعية — يعطي انعكاسات دافئة خفيفة على الشعر الفاتح فقط، وما يغيّر لون الشعر الداكن.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "متى أشوف النتيجة؟",
            "answer": "<p>النعومة واللمعان من أول استعمالات. نقص التساقط عادة بعد ٣–٥ أسابيع، والكثافة والنمو الجديد من الشهر الثاني — لهذا الباك علاج ثلاثة أشهر كاملة.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
