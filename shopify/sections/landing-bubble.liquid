.bm-qty .t{flex:1}
.bm-qty .t b{display:block;font-family:var(--display);font-size:17px;color:var(--forest)}
.bm-qty .t small{color:var(--muted);font-size:13px}
.bm-qty .p{text-align:end;font-weight:700;color:var(--forest);white-space:nowrap}
.bm-qty .p s{display:block;font-weight:400;font-size:13px;color:#9C9483}
.bm-tag{position:absolute;top:-11px;inset-inline-start:14px;background:var(--brass);color:#22190A;font-size:11px;
  font-weight:700;padding:3px 10px;border-radius:999px}
.bm-total{display:flex;align-items:baseline;justify-content:space-between;margin-top:var(--s3);
  padding-top:var(--s2);border-top:1px dashed var(--line);font-weight:700;color:var(--forest)}
