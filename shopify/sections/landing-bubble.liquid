.bm-final h2{color:#fff;font-size:clamp(24px,5.5vw,36px);margin-bottom:var(--s2)}
.bm-final p{color:rgba(232,225,203,.78);max-width:50ch;margin:0 auto var(--s3)}
.bm-final .bm-cta{margin-inline:auto;max-width:480px}
.bm-foot{background:#0F2416;color:rgba(232,225,203,.55);text-align:center;font-size:12px;padding:22px 20px 90px;line-height:2}
.bm-sticky{position:fixed;inset-inline:0;bottom:0;z-index:50;display:flex;align-items:center;gap:12px;
  padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:rgba(251,249,243,.97);
  border-top:1px solid var(--line);box-shadow:0 -6px 24px rgba(20,18,14,.14);
  transform:translateY(115%);transition:transform .28s var(--ease)}
.bm-sticky[data-on]{transform:none}
.bm-sticky .pr{display:flex;flex-direction:column;line-height:1.25}
.bm-sticky .pr b{font-family:var(--display);font-size:19px;color:var(--forest)}
.bm-sticky .pr s{font-size:12px;color:#9C9483}
.bm-sticky .bm-cta{flex:1;min-height:48px;font-size:15.5px;max-width:420px;margin-inline-start:auto}
.bm-wa{position:fixed;inset-inline-start:16px;bottom:84px;z-index:49;width:52px;height:52px;border-radius:50%;
  background:#1FAF54;display:grid;place-items:center;box-shadow:0 8px 20px rgba(31,175,84,.4)}
.bm-wa svg{width:28px;height:28px;fill:#fff}

/* Reveals */
[data-reveal]{opacity:0;transform:translateY(20px);transition:opacity .6s var(--ease),transform .6s var(--ease)}
[data-reveal].in{opacity:1;transform:none}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
  [data-reveal]{opacity:1;transform:none}
    .bm-sticky{transform:none}
}
</style>

<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- Révélations ---- */
  var items = document.querySelectorAll('[data-reveal]');
  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach(function(el){ el.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {rootMargin:'0px 0px -8% 0px', threshold:.08});
    items.forEach(function(el){ io.observe(el); });
  }

  /* ---- Interaction signature : révélateur avant/après ---- */
  var range = document.getElementById('revealRange'),
      box   = document.getElementById('revealBox'),
      bar   = document.getElementById('revealBar');
  if (range && box) {
    var apply = function(){
      var v = range.value;
      box.style.setProperty('--split', v + '%');
      bar.style.left = v + '%';
      range.setAttribute('aria-valuetext', 'العرض: ' + v + '٪ بعد');
    };
    range.addEventListener('input', apply);
    apply();
  }

  /* ---- Sélecteur de quantité ---- */
  var qtyInputs = document.querySelectorAll('input[name="qty"]'),
      totalOut  = document.getElementById('totalOut'),
      fQty      = document.getElementById('f-qty'),
      fTotal    = document.getElementById('f-total');
  function priceFor(input){ return Math.round(parseFloat(input.getAttribute('data-total'))); }
  qtyInputs.forEach(function(input){
    input.addEventListener('change', function(){
      var t = priceFor(input);
      if (totalOut) totalOut.textContent = t + ' ر.س';
      if (fQty)   fQty.value = input.value;
      if (fTotal) fTotal.value = t;
    });
  });

  /* ---- Barre sticky : apparaît après le hero, disparaît sur le formulaire ---- */
  var sticky = document.getElementById('sticky'),
      hero   = document.querySelector('.bm-hero'),
      order  = document.getElementById('order');
  if (sticky && 'IntersectionObserver' in window) {
    var heroOut = false, orderIn = false;
    var sync = function(){ sticky.toggleAttribute('data-on', heroOut && !orderIn); };
    new IntersectionObserver(function(e){ heroOut = !e[0].isIntersecting; sync(); }).observe(hero);
    new IntersectionObserver(function(e){ orderIn = e[0].isIntersecting; sync(); }, {threshold:.12}).observe(order);
  }

  /* ---- Formulaire COD de repli ---- */
  var es = document.getElementById('easysell-form-here'),
      form = document.getElementById('codForm'),
      wrap = document.getElementById('formWrap'),
      btn  = document.getElementById('submitBtn');

  // Si EasySell monte son formulaire dans l'ancre, on retire le repli.
  if (es && form) {
    setTimeout(function(){ if (es.children.length > 0) form.style.display = 'none'; }, 2500);
  }

  var PHONE = /^(?:\+?966|0)?5\d{8}$/;
  function setInvalid(field, bad){ if (bad) field.setAttribute('data-invalid',''); else field.removeAttribute('data-invalid'); }

  if (form) {
    form.querySelectorAll('input,select,textarea').forEach(function(el){
      el.addEventListener('blur', function(){ validate(el); });
    });
    function validate(el){
      var field = el.closest('.bm-field'); if (!field) return true;
      var v = (el.value || '').trim(), ok = v.length > 0;
      if (el.type === 'tel') ok = PHONE.test(v.replace(/[\s-]/g, ''));
      if (el.id === 'f-name') ok = v.length >= 3;
      setInvalid(field, !ok);
      return ok;
    }
    form.addEventListener('submit', function(ev){
      ev.preventDefault();
      if (btn.disabled) return;                                  // verrou anti double envoi
      var ok = true;
      form.querySelectorAll('[required]').forEach(function(el){ if (!validate(el)) ok = false; });
      if (!ok) { form.querySelector('[data-invalid] input,[data-invalid] select,[data-invalid] textarea').focus(); return; }

      btn.disabled = true;
      btn.textContent = 'جارٍ الإرسال…';

      /* CÂBLAGE À CHOISIR — une seule des trois options :
         1) Shopify + EasySell : laisser EasySell gérer (ce formulaire de repli disparaît alors tout seul).
         2) Google Sheets : fetch('<URL_APPS_SCRIPT>', {method:'POST', body:new FormData(form)})
         3) Service de formulaire : action="https://formspree.io/f/<ID>" method="post"
         Tant qu'aucun n'est branché, la commande n'est PAS enregistrée. */
      var data = Object.fromEntries(new FormData(form).entries());
      console.log('[COD] commande à envoyer :', data);

      setTimeout(function(){
        wrap.classList.add('bm-sent');
        wrap.scrollIntoView({behavior: reduce ? 'auto' : 'smooth', block:'center'});
        /* Événements de conversion — sur le succès, pas au clic :
           if (window.fbq)   fbq('track','Purchase',{value:data.total,currency:'SAR'});
           if (window.ttq)   ttq.track('PlaceAnOrder',{value:data.total,currency:'SAR'});
           if (window.snaptr) snaptr('track','PURCHASE',{price:data.total,currency:'SAR'});
           window.dataLayer = window.dataLayer || []; dataLayer.push({event:'cod_order', value:data.total}); */
      }, 600);
    });
  }
})();
</script>

