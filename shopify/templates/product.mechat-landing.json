        "row3": {
          "type": "row",
          "settings": {
            "image_asset": "mechat-reveal.webp",
            "video_asset": "mechat-reveal-video.mp4",
            "badge": "النتيجة",
            "title": "شعر يستحق الانتظار",
            "text": "<p>النعومة تحسين فيها من أول غسلة. ومع كل أسبوع، الجذور أقوى، الفراغات تمتلئ، واللمعة ترجع — حتى تصير تمشيطة الصباح لحظة تفتخرين فيها بشعرك.</p>"
          }
        }
