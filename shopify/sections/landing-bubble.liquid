  border-radius:999px;padding:7px 14px;font-size:13.5px}
.bm-swatch span{width:16px;height:16px;border-radius:50%;border:1px solid rgba(0,0,0,.15)}
@media (min-width:768px){.bm-box{grid-template-columns:1fr 1fr}}

/* Garantie (à la place de faux avis) */
.bm-guarantee{background:var(--forest);color:#E8E1CB}
.bm-guarantee .bm-wrap{display:grid;gap:var(--s3);padding-block:var(--s5);text-align:center;justify-items:center}
