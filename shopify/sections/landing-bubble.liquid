<style>
/* ============ TOKENS ============ */
:root{
  --ivory:#F3EFE4; --surface:#FBF9F3; --forest:#17331F; --leaf:#5B9B4A;
  --brass:#B98A2E; --brass-hi:#D8AC4E; --ink:#14120E; --muted:#6B6455; --line:#E2DACB;
  --radius:18px; --shadow:0 12px 30px rgba(20,18,14,.10); --shadow-lg:0 20px 48px rgba(20,18,14,.16);
  --display:'Reem Kufi',system-ui,sans-serif; --body:'Tajawal',system-ui,sans-serif;
  --ease:cubic-bezier(.22,.61,.36,1);
  --s1:8px; --s2:16px; --s3:24px; --s4:40px; --s5:64px; --s6:96px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--ivory);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
h1,h2,h3{font-family:var(--display);line-height:1.35;margin:0;font-weight:700;text-wrap:balance}
p{margin:0}
:focus-visible{outline:3px solid var(--brass);outline-offset:3px;border-radius:6px}
.bm-wrap{max-width:1120px;margin-inline:auto;padding-inline:20px}
.bm-center{text-align:center}
.bm-eyebrow{font-size:13px;letter-spacing:2px;color:var(--brass);font-weight:700}
.bm-h2{font-size:clamp(25px,5.5vw,38px)}
.bm-lead{color:var(--muted);font-size:16px;max-width:56ch;margin-inline:auto}
.bm-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* ============ SIGNATURE : LISIÈRE DE MOUSSE ============ */
.bm-foam{display:block;width:100%;height:38px;line-height:0}
.bm-foam svg{width:100%;height:100%;display:block}
@media (min-width:768px){.bm-foam{height:54px}}

/* ============ CTA ============ */
.bm-cta{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:58px;
  padding:14px 26px;border:none;border-radius:var(--radius);cursor:pointer;
  background:linear-gradient(135deg,var(--brass-hi),var(--brass) 52%,#8F6A18);
  color:#22190A;font-family:var(--body);font-size:17px;font-weight:700;
  box-shadow:0 8px 22px rgba(185,138,46,.34);transition:transform .18s var(--ease),box-shadow .18s var(--ease)}
.bm-cta:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(185,138,46,.46)}
.bm-cta:active{transform:translateY(0)}
.bm-cta-note{font-size:13px;color:var(--muted);text-align:center;margin-top:10px}
@media (min-width:768px){.bm-cta{width:auto;min-width:340px}}

/* ============ ANNONCE + HEADER ============ */
.bm-announce{background:var(--forest);color:#E6DFC9;font-size:13px;text-align:center;padding:9px 16px}
.bm-head{position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;
  gap:12px;padding:10px 20px;background:rgba(251,249,243,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bm-logo{display:flex;flex-direction:column;line-height:1.1}
.bm-logo b{font-family:var(--display);font-size:20px;color:var(--forest)}
.bm-logo span{font-size:10px;letter-spacing:4px;color:var(--brass)}
.bm-pill{padding:9px 18px;border-radius:999px;background:var(--forest);color:#F3EFE4;font-size:14px;font-weight:700;white-space:nowrap}

/* ============ HERO ============ */
.bm-hero{position:relative;overflow:hidden;background:var(--surface)}
.bm-hero-bg{position:absolute;inset:0;object-fit:cover;width:100%;height:100%;opacity:.30}
.bm-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(251,249,243,.55),rgba(251,249,243,.94))}
.bm-hero-in{position:relative;z-index:2;display:grid;gap:var(--s3);padding:var(--s4) 20px var(--s5);max-width:1120px;margin-inline:auto}
.bm-badge{display:inline-flex;align-items:center;gap:8px;align-self:start;padding:7px 15px;border-radius:999px;
  background:rgba(91,155,74,.12);border:1px solid rgba(91,155,74,.32);color:#39662C;font-size:13px;font-weight:700}
.bm-h1{font-size:clamp(29px,6.8vw,46px);letter-spacing:-.5px;max-width:15ch;text-wrap:balance}
.bm-h1 em{font-style:normal;color:var(--brass);display:block}
.bm-hero p.bm-sub{color:var(--muted);font-size:17px;max-width:46ch;margin-top:var(--s2)}
.bm-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:12px;margin:var(--s3) 0 var(--s2)}
.bm-price b{font-family:var(--display);font-size:40px;color:var(--forest);line-height:1}
.bm-price b small{font-size:17px;font-weight:500}
.bm-price s{color:#9C9483;font-size:18px}
.bm-price i{font-style:normal;background:#8F1F1F;color:#fff;font-size:13px;font-weight:700;padding:4px 11px;border-radius:999px}
.bm-hero-proof{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:var(--s3);font-size:14px;color:#4A4536}
.bm-hero-proof span{display:flex;align-items:center;gap:6px}
.bm-hero-visual{position:relative;justify-self:center;width:100%;max-width:420px}
.bm-hero-visual img{width:100%;border-radius:22px;box-shadow:var(--shadow-lg)}
.bm-gift{position:absolute;inset-inline-start:0;bottom:8%;background:var(--surface);border:1px solid var(--line);
  border-radius:14px;padding:9px 14px;box-shadow:var(--shadow);font-size:13px;font-weight:700;color:var(--forest)}
.bm-gift b{color:var(--brass)}
@media (min-width:900px){
  .bm-hero-in{grid-template-columns:1.05fr .95fr;align-items:center;gap:var(--s5);padding-block:var(--s6)}
  .bm-hero-visual{max-width:none}
}

/* ============ BANDEAU CONFIANCE ============ */
.bm-trust{background:var(--forest);color:#DFD8C2}
.bm-trust ul{list-style:none;margin:0;padding:var(--s3) 20px;display:grid;grid-template-columns:repeat(2,1fr);
  gap:14px;max-width:1120px;margin-inline:auto}
.bm-trust li{display:flex;align-items:center;gap:9px;font-size:14px;font-weight:500}
.bm-trust svg{flex:none;width:20px;height:20px;stroke:var(--brass-hi);fill:none;stroke-width:2}
@media (min-width:768px){.bm-trust ul{grid-template-columns:repeat(4,1fr)}}

/* ============ SECTIONS ============ */
section{scroll-margin-top:70px}
.bm-sec{padding:var(--s5) 0}
.bm-sec-head{display:grid;gap:10px;justify-items:center;text-align:center;margin-bottom:var(--s4)}
.bm-rule{width:64px;height:3px;border-radius:2px;background:linear-gradient(90deg,var(--brass-hi),var(--brass))}

/* Problème */
.bm-problem{background:var(--surface)}
.bm-problem-grid{display:grid;gap:var(--s2)}
.bm-pain{background:var(--ivory);border:1px solid var(--line);border-radius:var(--radius);padding:var(--s3)}
.bm-pain b{display:block;font-family:var(--display);font-size:18px;color:var(--forest);margin-bottom:6px}
.bm-pain span{color:var(--muted);font-size:15px}
@media (min-width:768px){.bm-problem-grid{grid-template-columns:repeat(3,1fr)}}

/* Révélateur avant/après */
.bm-reveal{position:relative;max-width:520px;margin-inline:auto;border-radius:var(--radius);overflow:hidden;
  box-shadow:var(--shadow-lg);background:var(--surface);aspect-ratio:3/4}
.bm-reveal img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.bm-reveal .bm-after{clip-path:inset(0 0 0 var(--split,50%))}
.bm-reveal-tag{position:absolute;top:12px;font-size:12px;font-weight:700;padding:5px 12px;border-radius:999px;
  background:rgba(20,18,14,.68);color:#fff;z-index:3}
.bm-reveal-tag.r{inset-inline-end:12px}.bm-reveal-tag.l{inset-inline-start:12px}
.bm-reveal-bar{position:absolute;top:0;bottom:0;width:3px;background:#fff;box-shadow:0 0 12px rgba(0,0,0,.4);
  left:var(--split,50%);transform:translateX(-50%);z-index:4;pointer-events:none}
.bm-reveal-knob{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:52px;height:52px;border-radius:50%;
  background:radial-gradient(circle at 34% 30%,#fff,rgba(255,255,255,.72) 58%,rgba(255,255,255,.42));
  border:2px solid #fff;box-shadow:0 6px 18px rgba(0,0,0,.28);display:grid;place-items:center;color:var(--forest);font-size:15px}
.bm-range{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;z-index:5;margin:0;direction:ltr}
.bm-illus{text-align:center;font-size:12px;color:var(--muted);margin-top:12px}

/* Essences */
.bm-essences{background:var(--forest);color:#E8E1CB}
.bm-essences .bm-h2,.bm-essences .bm-eyebrow{color:#fff}
.bm-essences .bm-eyebrow{color:var(--brass-hi)}
.bm-essences .bm-lead{color:rgba(232,225,203,.75)}
.bm-ess-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--s2)}
.bm-ess{background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.11);border-radius:var(--radius);
  padding:var(--s2);text-align:center}
.bm-ess img{width:88px;height:88px;border-radius:50%;object-fit:cover;margin:0 auto 12px}
.bm-ess b{display:block;font-family:var(--display);font-size:17px;color:#fff}
.bm-ess span{font-size:13px;color:rgba(232,225,203,.72);line-height:1.7}
