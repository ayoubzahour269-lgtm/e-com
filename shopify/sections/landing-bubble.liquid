.bm-gua{background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.12);border-radius:var(--radius);padding:16px}
.bm-gua b{display:block;font-family:var(--display);color:var(--brass-hi);font-size:20px}
.bm-gua span{font-size:13.5px;color:rgba(232,225,203,.72)}
@media (min-width:768px){.bm-gua-grid{grid-template-columns:repeat(4,1fr)}}

/* Commande */
.bm-order{background:var(--surface)}
.bm-order-grid{display:grid;gap:var(--s4)}
.bm-offer{background:var(--ivory);border:1px solid var(--line);border-radius:var(--radius);padding:var(--s3)}
