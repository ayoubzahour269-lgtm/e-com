{% comment %} Offres en packs + compte à rebours — style RizqBio {% endcomment %}
<div class="lpo" dir="rtl" id="lp-offers">
  <div class="lpo__container">
    <h2 class="lpo__heading">{{ section.settings.heading }}</h2>
    <div class="lpo__grid">
      {% for block in section.blocks %}
        <div class="lpo__card lpx-reveal {% if block.settings.featured %}lpo__card--hot{% endif %}" data-delay="{{ forloop.index0 | times: 140 }}" {{ block.shopify_attributes }}>
          {% if block.settings.badge != blank %}<div class="lpo__badge">{{ block.settings.badge }}</div>{% endif %}
          <div class="lpo__qty">{{ block.settings.qty_label }}</div>
          <div class="lpo__title">{{ block.settings.title }}</div>
          <div class="lpo__prices">
            <span class="lpo__price">{{ block.settings.price }}</span>
            {% if block.settings.old_price != blank %}<s class="lpo__old">{{ block.settings.old_price }}</s>{% endif %}
          </div>
          {% if block.settings.note != blank %}<div class="lpo__note">{{ block.settings.note }}</div>{% endif %}
          <button class="lpo__btn" onclick="(document.querySelector('easysell-form,[id*=easysell],product-form,form[action*=\'/cart/add\']')||document.body).scrollIntoView({behavior:'smooth'})">
            اختار هذا العرض
          </button>
        </div>
      {% endfor %}
    </div>
    <p class="lpo__hint">أكملي الطلب في النموذج بالأسفل</p>
  </div>
</div>



<style>
  .lpo{ background:var(--lpx-hero-bg,linear-gradient(180deg,#1b242e,#10161d)); color:#fff; padding:48px 16px; }
  .lpo__container{ max-width:1020px; margin-inline:auto; text-align:center; }
  .lpo__heading{ font-size:1.7rem; font-weight:900; margin:0 0 14px; color:#fff; }
  .lpo__countdown{ display:inline-flex; align-items:center; gap:10px; background:rgba(214,69,69,.15);
    border:1px solid rgba(214,69,69,.5); color:#ffb4b4; font-weight:800; border-radius:999px;
    padding:8px 22px; margin-bottom:28px; font-size:.95rem; }
  .lpo__timer{ font-family:monospace; font-size:1.15rem; color:#fff; letter-spacing:2px; }
  .lpo__grid{ display:grid; grid-template-columns:repeat({{ section.blocks.size | at_most: 3 }},1fr); gap:18px; align-items:stretch; }
  .lpo__card{ position:relative; background:#fff; color:#1b2430; border-radius:20px; padding:30px 18px 22px;
    box-shadow:0 20px 50px -20px rgba(0,0,0,.45); display:flex; flex-direction:column; gap:8px; }
  .lpo__card--hot{ outline:3px solid #c9a557; transform:scale(1.03); }
  .lpo__badge{ position:absolute; top:-14px; right:50%; transform:translateX(50%); white-space:nowrap;
    background:linear-gradient(135deg,#dcb96a,#c9a557); color:#2b1f06; font-weight:800; font-size:.8rem;
    padding:6px 18px; border-radius:999px; box-shadow:0 8px 18px -6px rgba(0,0,0,.35); }
  .lpo__qty{ font-size:2rem; }
  .lpo__title{ font-family:'Cairo',sans-serif; font-weight:800; font-size:1.05rem; }
  .lpo__prices{ display:flex; align-items:baseline; justify-content:center; gap:10px; }
  .lpo__price{ font-family:'Cairo',sans-serif; font-size:1.7rem; font-weight:900; color:#a3823c; }
  .lpo__old{ color:#a33; font-size:.95rem; }
  .lpo__note{ background:#f1ede5; color:#7a6330; font-weight:700; font-size:.8rem; border-radius:999px; padding:5px 14px; }
  .lpo__btn{ margin-top:auto; font-family:'Cairo',sans-serif; font-weight:800; font-size:.98rem;
    background:linear-gradient(135deg,#dcb96a,#c9a557 55%,#b8923f); color:#2b1f06;
    border:none; border-radius:999px; padding:12px 20px; cursor:pointer;
    box-shadow:0 12px 26px -10px rgba(184,146,63,.55); }
  .lpo__hint{ margin:20px 0 0; color:#98a4b1; font-size:.88rem; }
  @media(max-width:749px){
    .lpo__grid{ grid-template-columns:1fr; }
    .lpo__card--hot{ transform:none; }
    .lpo__heading{ font-size:1.3rem; }
  }
</style>

{% schema %}
{
  "name": "LP — العروض",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "اختار عرضك — كل ما زادت الكمية زاد التوفير" }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "عرض",
      "settings": [
        { "type": "text", "id": "qty_label", "label": "إيموجي/كمية", "default": "1️⃣" },
        { "type": "text", "id": "title", "label": "اسم العرض", "default": "قطعة واحدة" },
        { "type": "text", "id": "price", "label": "السعر", "default": "90 ر.س" },
        { "type": "text", "id": "old_price", "label": "السعر القديم", "default": "146 ر.س" },
        { "type": "text", "id": "note", "label": "ملاحظة", "default": "توصيل مجاني" },
        { "type": "text", "id": "badge", "label": "شارة (اختياري)" },
        { "type": "checkbox", "id": "featured", "label": "العرض المميز", "default": false }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [ { "name": "LP — العروض", "blocks": [ { "type": "offer" }, { "type": "offer" } ] } ]
}
{% endschema %}
